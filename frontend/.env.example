# Origin of the Node.js API service. Next.js reverse-proxies /api/v1/* to it,
# so the browser always stays same-origin.
API_ORIGIN=http://localhost:4000

NEXT_PUBLIC_APP_NAME=Secure Business Portal

# Hostnames besides localhost allowed to use the dev server, comma-separated (e.g. your LAN IP for the Android app).
# DEV_ORIGINS=192.168.1.10
