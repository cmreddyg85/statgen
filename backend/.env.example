# --- Runtime ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/secure_portal
DATABASE_SSL=false

# --- Session ---
SESSION_COOKIE_NAME=app_session
# Server-side pepper mixed into the session-token hash. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET_OR_PEPPER=change-me-in-every-environment-please-use-48-random-bytes
SESSION_TTL_USER_MINUTES=15
SESSION_TTL_ADMIN_HOURS=24
CSRF_COOKIE_NAME=app_csrf

# --- CORS (only needed when the web app is NOT served same-origin) ---
ALLOWED_ORIGINS=http://localhost:3000

# --- Security ---
COOKIE_SECURE=auto
COOKIE_SAME_SITE=lax
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
PASSWORD_MIN_LENGTH=12
MOBILE_NUMBER_REGEX=^[0-9]{10,15}$

# --- Bootstrap admin (used by `npm run seed`) ---
# The seeded administrator's first password is set equal to its username, and
# must be changed from the profile menu at first sign-in.
BOOTSTRAP_ADMIN_NAME=Platform Administrator
BOOTSTRAP_ADMIN_USERNAME=admin
